<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>jade-server</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jade.Core\Jade.Core.csproj" />
    <ProjectReference Include="..\Jade.Native\Jade.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\native\bin\jade.dll" Condition="Exists('..\..\native\bin\jade.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
